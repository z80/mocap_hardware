	{
	}
}

char * read_cmd( int * cmd_len )
{
	static char buffer[256];
	static const int buffer_size = sizeof(buffer);
	int char_index = 0;
	for (int i=0; i<buffer_size; i++)
	{
		char c;
		const enum HAL_StatusTypeDef ret = HAL_UART_Receive( huart2, &c, 1, 1 );
		if ( ret == HAL_OK )
		{
			buffer[char_index] = c;
			char_index += 1;
			if ( c == "\n" )
			{
				if (cmd_len != 0)
				{
					*cmd_len = char_index;
				}
				char_index = 0;
				return buffer;
			}
		}
	}
}

