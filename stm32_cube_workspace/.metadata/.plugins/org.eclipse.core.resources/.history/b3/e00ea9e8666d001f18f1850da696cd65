	bno055_inst_a.bus_read   = bno055_bus_read_i2c_a;
	bno055_inst_a.delay_msec = bno055_delay;
	bno055_inst_a.dev_addr   = BNO055_I2C_ADDR1 << 1;

	bno055_inst_b.bus_write  = bno055_bus_write_i2c_b;
	bno055_inst_b.bus_read   = bno055_bus_read_i2c_b;
	bno055_inst_b.delay_msec = bno055_delay;
	bno055_inst_b.dev_addr   = BNO055_I2C_ADDR1 << 1;

}


