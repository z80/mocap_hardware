

#include "task_led.h"
#include "main.h"

static void func_task_led( void * p );

uint8_t led_value = 0x01;
static osMutexDef_t mutex;
static osMutexId    mutexId;
//osThreadDef(imuTask, vTaskImu, osPriorityAboveNormal, 0, 512);
osThreadDef(task_led, func_task_led, osPriorityNormal, 0, 128);


void task_imu_init()
{
	osThreadCreate( osThread(task_led), NULL );
}


void func_task_led( void * p )
{
	MX_USB_DEVICE_Init();
	/* USER CODE BEGIN 5 */
	/* Infinite loop */
	for(;;)
	{
		osMutexWait( mutexId, osWaitForever );
		uint8_t v = led_value;
		obMutexRelease( mutexId );

		if (v & 0x01)
			HAL_GPIO_TogglePin( LED_0_GPIO_Port, LED_0_Pin );
		else
			HAL_GPIO_ClearPin( LED_0_GPIO_Port, LED_0_Pin );

		if (v & 0x02)
			HAL_GPIO_TogglePin( LED_1_GPIO_Port, LED_1_Pin );
		else
			HAL_GPIO_ClearPin( LED_1_GPIO_Port, LED_1_Pin );

		if (v & 0x04)
			HAL_GPIO_TogglePin( LED_2_GPIO_Port, LED_2_Pin );
		else
			HAL_GPIO_ClearPin( LED_2_GPIO_Port, LED_2_Pin );

		osDelay(500);
	}
}





