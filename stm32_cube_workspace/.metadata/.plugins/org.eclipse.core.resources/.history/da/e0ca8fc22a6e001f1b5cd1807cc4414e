{
	osThreadCreate( osThread(task_uart_rx), NULL );
	osThreadCreate( osThread(task_uart_tx), NULL );
}


extern UART_HandleTypeDef huart2;

static char * read_cmd();
void parse_cmd( const char * cmd, int cmd_len );

void func_task_uart_rx( void * p )
{
	for (;;)
	{
		int cmd_len;
		char * cmd = read_cmd( cmd_len );
	}
}

char * read_cmd( int * cmd_len )
{
	static char buffer[256];
	static const int buffer_size = sizeof(buffer);
	int char_index = 0;
	for (int i=0; i<buffer_size; i++)
	{
		char c;
		int ret = HAL_UART_Receive( &huart2, &c, 1, 10 );
		if ( ret == HAL_OK )
		{
			if (c == "\r")
				continue;
			if (c == "\t")
				c = ' ';
			buffer[char_index] = c;
			char_index += 1;
			if ( c == "\n" )
			{
				buffer[char_index] = '\0';
				if (cmd_len != 0)
				{
					*cmd_len = char_index;
				}
				char_index = 0;
				return buffer;
			}
		}
	}

	if (cmd_len != 0)
	{
		*cmd_len = buffer_size;
	}
	return buffer;
}

void parse_cmd( const char * cmd, int cmd_len )
{
	buffer[sizeof(buffer) - 1] = '\0'; // Ensure null-termination

	char *saveptr;
	char *word = strtok_r( buffer, " ", &saveptr );
	while (word != 0)
	{
	    processWord(word);
	    word = strtok_r( NULL, " ", &saveptr );
	}
}

